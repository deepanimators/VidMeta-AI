# VidMeta AI local configuration

# Required only if you want a stable encrypted cookie key across restarts.
# Generate your own long random value before publishing a hosted deployment.
VIDMETA_COOKIE_PASSWORD=change-this-local-cookie-password

# Streamlit browser upload limits in MB. Local file path mode can process larger
# files without pushing the video through the browser upload channel.
VIDMETA_MAX_UPLOAD_MB=2048
VIDMETA_MAX_MESSAGE_MB=2048

# Optional provider keys. The app also lets users enter these in the sidebar.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama default.
OLLAMA_BASE_URL=http://localhost:11434
