# VidMeta AI service configuration

VIDMETA_API_HOST=127.0.0.1
VIDMETA_API_PORT=8000
VIDMETA_DATA_DIR=.local/vidmeta
VIDMETA_DATABASE=.local/vidmeta/vidmeta.db
VIDMETA_UPLOAD_DIR=.local/vidmeta/uploads
VIDMETA_PROCESSING_DIR=.local/vidmeta/processing
VIDMETA_MAX_UPLOAD_MB=2048

# --- Security ---

# Encryption key for API keys and S3 credentials stored in SQLite.
# If not set, an auto-generated key is saved to $VIDMETA_DATA_DIR/.secret_key (mode 600).
# Set explicitly to make encryption portable (e.g., when migrating data between hosts).
VIDMETA_SECRET_KEY=

# Colon-separated list of filesystem base directories accessible to local-path jobs.
# Defaults to $HOME when running locally (unrestricted). Set in hosted environments.
# Example: VIDMETA_ALLOWED_PATHS=/home/user/Videos:/mnt/nas/media
VIDMETA_ALLOWED_PATHS=

# --- CORS ---

# Comma-separated allowed CORS origins. Defaults to * (all origins) when not set.
# Tighten in hosted deployments: VIDMETA_CORS_ORIGINS=http://localhost:5173,https://yourdomain.com
VIDMETA_CORS_ORIGINS=http://localhost:5173

# --- Retention ---

# Days to retain uploaded video records before cleanup (0 = never purge).
# Trigger cleanup manually via POST /api/admin/cleanup.
VIDMETA_UPLOAD_RETENTION_DAYS=0

# --- Frontend ---

# Optional Vite API base URL override. In dev, /api is proxied automatically.
VITE_API_BASE=
