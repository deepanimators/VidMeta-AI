{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidMeta AI",
  "version": "2.0.0",
  "identifier": "ai.vidmeta.desktop",
  "build": {
    "beforeDevCommand": "cd ../../web && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../../web && npm run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "VidMeta AI",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
